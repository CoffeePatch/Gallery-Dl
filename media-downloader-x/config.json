{
    "extractor": {
        "twitter": {
            "conversations": true,
            "expand": true,
            "directory": ["{author[name]}"],
            "filename": "{tweet_id}_{id}.{extension}",
            "postprocessors": [
                {
                    "name": "metadata",
                    "event": "post",
                    "filename": "{author[name]}_master_index.md",
                    "open": "a",
                    "mode": "custom",
                    "format": "### 🐦 Tweet ID: `{tweet_id}`\n**Date:** {date}\n\n{content}\n\n📁 **Media File:** `{filename}.{extension}`\n\n---\n\n"
                }
            ]
        }
    }
}