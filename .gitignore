# Dependencies
node_modules/
__pycache__/
*.pyc

# Local Data and Outputs
# Ignore the entire TweetData folder (JSONs, Media, Timelines, Threads, Account Statuses)
/TweetData/
*.log

# Secrets / Auth / Session Data
/Config/Cookies/
/Config/Settings/auth.json

# Target Lists (Private handles and URLs)
/Config/Users/*.txt
# (Optional) Allow example files to be pushed if you create them
!/Config/Users/*example*.txt

# Queues and State Trackers
/Config/Queues/

# Scraping Output and Scratch Files
/gallery-dl/
*.tmp.json
temp_*.json
test_*.json
