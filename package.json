{
  "name": "gallery-dl-suite",
  "version": "1.0.0",
  "description": "Unified dependencies for Gallery-Dl project scripts",
  "main": "index.js",
  "scripts": {
    "scrape": "powershell -ExecutionPolicy Bypass -File ./Scripts/gallerydl_batch_scraper.ps1",
    "scrape:skip": "powershell -ExecutionPolicy Bypass -File ./Scripts/gallerydl_batch_scraper.ps1 -Skip",
    "scrape:overwrite": "powershell -ExecutionPolicy Bypass -File ./Scripts/gallerydl_batch_scraper.ps1 -Overwrite",
    "threads": "node ./Scripts/thread_manager.js",
    "timeline": "node ./Scripts/generate_timeline.js",
    "timeline:batch": "node ./Scripts/generate_timeline.js --batch",
    "media": "node ./Scripts/download_media.js",
    "stats": "node ./Scripts/maintenance_manager.js --stats",
    "filter-large": "node ./Scripts/maintenance_manager.js --filter-large",
    "separate-threads": "node ./Scripts/maintenance_manager.js --separate-threads",
    "clean-retweets": "node ./Scripts/maintenance_manager.js --clean-retweets",
    "x-check": "node ./Scripts/maintenance_manager.js --x-check",
    "x-auth": "node ./Scripts/maintenance_manager.js --x-auth",
    "maintenance": "node ./Scripts/maintenance_manager.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "single-file-core": "^1.5.84"
  }
}
