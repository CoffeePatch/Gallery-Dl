{
  "extractor": {
    "base-directory": "./Tweets",
    "archive": "./Tweets/archive.sqlite3",
    "twitter": {
      "include": "media",
      "download": true,
      "text-tweets": false,
      "retweets": true,
      "replies": true,
      "quoted": true,
      "unique": true,
      "directory": [
        "{author[name]}"
      ],
      "filename": "{tweet_id}_{date!D:%Y%m%d_%H%M%S}_{num}_{filename}.{extension}"
    }
  },
  "downloader": {
    "filesize-max": "200m"
  },
  "postprocessors": [
    {
      "name": "metadata",
      "event": "post",
      "mode": "custom",
      "filename": "{author[name]}_tweets.html",
      "open": "a",
      "content-format": "<article>\n<h2><a href=\"https://x.com/{author[name]}/status/{tweet_id}\">Tweet {tweet_id}</a></h2>\n<p>User: {author[name]} | Date: {date} | Type: {type} | File: {tweet_id}_{date!D:%Y%m%d_%H%M%S}_{num}_{filename}.{extension}</p>\n<pre>{content}</pre>\n<hr>\n</article>\n"
    }
  ]
}