{
  "name": "gallery-dl-suite",
  "version": "1.0.0",
  "description": "Unified dependencies for Gallery-Dl project scripts",
  "main": "index.js",
  "scripts": {
    "scrape": "powershell -ExecutionPolicy Bypass -File ./Scripts/AccountBatchProcessing/gallerydl_batch_scraper.ps1",
    "scrape:skip": "powershell -ExecutionPolicy Bypass -File ./Scripts/AccountBatchProcessing/gallerydl_batch_scraper.ps1 -Skip",
    "scrape:overwrite": "powershell -ExecutionPolicy Bypass -File ./Scripts/AccountBatchProcessing/gallerydl_batch_scraper.ps1 -Overwrite",
    "threads": "node ./Scripts/ThreadProcessing/thread_manager.js",
    "timeline": "node ./Scripts/SnapshotRenderer/generate_timeline.js",
    "timeline:batch": "node ./Scripts/SnapshotRenderer/generate_timeline.js --batch",
    "media": "node ./Scripts/DownloadMedia/download_media.js",
    "stats": "node ./Scripts/DataUtilities/maintenance_manager.js --stats",
    "filter-large": "node ./Scripts/DataUtilities/maintenance_manager.js --filter-large",
    "separate-threads": "node ./Scripts/DataUtilities/maintenance_manager.js --separate-threads",
    "clean-retweets": "node ./Scripts/DataUtilities/maintenance_manager.js --clean-retweets",
    "x-check": "node ./Scripts/DataUtilities/maintenance_manager.js --x-check",
    "x-auth": "node ./Scripts/DataUtilities/maintenance_manager.js --x-auth",
    "maintenance": "node ./Scripts/DataUtilities/maintenance_manager.js",
    "snapshot": "python ./Scripts/SnapshotRenderer/generate_visual_archive.py",
    "test": "node --test Scripts/tests/*.test.js && node -e \"const {getPythonCommand}=require('./Scripts/lib/pythonResolver'); const {execSync}=require('child_process'); const py=getPythonCommand(); execSync(py+' -m unittest discover -s Scripts/tests -p test_*.py', {stdio:'inherit'}); execSync(py+' Scripts/DataUtilities/test_dedup_keys.py', {stdio:'inherit'});\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "single-file-core": "^1.5.84"
  }
}
